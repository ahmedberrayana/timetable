rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return request.auth != null && me().role == 'ADMIN'; }
    match /users/{id}          { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /groups/{id}         { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /courses/{id}        { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /scheduleSlots/{id}  { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /notificationLogs/{id} { allow read: if request.auth != null; allow write: if isAdmin(); }
  }
}
